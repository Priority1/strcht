# ── what to stream ─────────────────────────────────────────────
# every video file directly in this directory is a stream (not recursive); description.txt next to them is read for notes
MEDIA_DIR=~/Downloads/Mayflower
# segments, thumbnails, meta — built once per file, rebuilt when the file or the settings below change (~1.2x the size of the videos)
DATA_DIR=./data
# translation preset per video (source language + Delta2 / auto), handed to the console in the beacon; see presets.json
PRESETS_FILE=./presets.json

# ── where to listen ────────────────────────────────────────────
HOST=127.0.0.1
PORT=8790
# base of the urls handed out by /pinhole/list; empty = the host the request came to (set it behind a proxy / on a LAN name)
PUBLIC_URL=
# when set, /pinhole/list wants `authorization: bearer <token>` (scripts/console.sh hands it to the console)
PINHOLE_TOKEN=

# ── the streams ────────────────────────────────────────────────
# 1 s is what low-latency live platforms cut, and what the console on top is tuned for
SEGMENT_SECONDS=1
# segments in a live playlist
LIVE_WINDOW_SEGMENTS=12
# hi rendition: encode = re-encoded with a keyframe every SEGMENT_SECONDS (hardware encoder on a Mac)
#               copy   = the source's packets as they are; instant, but a segment is one source GOP (2 s for these files)
HI_MODE=encode
# height of the lo (preview) rendition; its audio is the source's, untouched
LO_HEIGHT=360

# ── thumbnails ─────────────────────────────────────────────────
THUMB_EVERY_SECONDS=10
THUMB_WIDTH=320

# ── building ───────────────────────────────────────────────────
INGEST_WORKERS=4
RESCAN_SECONDS=30

# ── the console on top (scripts/console.sh) ────────────────────
# The translation console is another project, run from its own checkout and left as it is.
# its checkout (with its own .venv and .env)
CONSOLE_DIR=
# the name of the console's own variable for the beacon url, and for the beacon's bearer token
CONSOLE_LIST_VAR=
CONSOLE_TOKEN_VAR=
# names the console shows that this demo must not, comma separated (a customer it was first written for, …):
# they are rewritten in every page, script, option list, sign-in prompt and log line it puts out (console/skin.py)
CONSOLE_HIDE=
